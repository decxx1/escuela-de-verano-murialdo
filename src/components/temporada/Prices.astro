---
import type { Turno } from '@/types/content';

interface Props { turnos: Turno[]; tituloPrecios?: string }
const { turnos, tituloPrecios = '' } = Astro.props;
const currency = new Intl.NumberFormat('es-AR', {
    style: 'currency', currency: 'ARS', minimumFractionDigits: 0, maximumFractionDigits: 2,
});
---

<div data-price-tabs>
    <p class:list={['text-white/85 text-lg sm:text-xl text-center', tituloPrecios ? 'mb-4' : 'mb-8']}>Conocé los precios según tu condición y turno elegido</p>
    {tituloPrecios && <h3 class="font-atma font-bold text-secondary text-2xl md:text-3xl text-center mb-8">{tituloPrecios}</h3>}

    <div role="tablist" aria-label="Turno de la escuela de verano" class="flex flex-wrap gap-2 mb-8 justify-center">
        {turnos.map((turno, index) => (
            <button
                id={'price-tab-' + index}
                type="button"
                role="tab"
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={'price-panel-' + index}
                tabindex={index === 0 ? 0 : -1}
                class="cursor-pointer px-5 sm:px-8 py-3 rounded-2xl font-atma font-bold text-xl md:text-2xl transition-colors border-2 border-secondary/60 text-white hover:bg-secondary/15 aria-selected:bg-secondary aria-selected:border-secondary aria-selected:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
            >{turno.Turno}</button>
        ))}
    </div>

    {turnos.map((turno, turnoIndex) => (
        <div id={'price-panel-' + turnoIndex} role="tabpanel" aria-labelledby={'price-tab-' + turnoIndex} tabindex="0" hidden={turnoIndex !== 0} class="rounded-2xl focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {turno.Condiciones.map(condicion => (
                    <article class="border-2 border-secondary rounded-3xl p-5 sm:p-6 flex flex-col">
                        <div class="mb-5 pb-4 border-b border-secondary/30">
                            <h3 class="text-primary text-outline-2 font-atma font-bold text-2xl md:text-3xl text-center">{condicion.Condicion}</h3>
                        </div>
                        <dl class="space-y-4 flex-1">
                            {condicion.precios.map(precio => (
                                <div class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 p-4">
                                    <dt class="min-w-0 break-words text-white font-semibold text-base md:text-lg">{precio.MedioDePago}</dt>
                                    <dd class="text-secondary font-bold text-xl md:text-2xl text-right whitespace-nowrap">{currency.format(precio.Precio)}</dd>
                                </div>
                            ))}
                        </dl>
                    </article>
                ))}
            </div>
        </div>
    ))}

    <div class="mt-8 border border-secondary/40 rounded-2xl p-5">
        <p class="text-white/85 text-center text-sm md:text-base leading-relaxed">
            <span class="font-bold text-secondary">Nota:</span> Los precios están sujetos a cambios.
            Para más información sobre descuentos por hermanos o promociones especiales, contactanos directamente.
        </p>
    </div>
</div>

<script>
    function initializePriceTabs() {
        document.querySelectorAll<HTMLElement>('[data-price-tabs]').forEach(root => {
            if (root.dataset.initialized) return;
            root.dataset.initialized = 'true';
            const buttons = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
            const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
            function activate(index: number) {
                buttons.forEach((button, buttonIndex) => {
                    button.setAttribute('aria-selected', String(buttonIndex === index));
                    button.tabIndex = buttonIndex === index ? 0 : -1;
                });
                panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
            }
            buttons.forEach((button, index) => {
                button.addEventListener('click', () => activate(index));
                button.addEventListener('keydown', event => {
                    let next: number;
                    if (event.key === 'ArrowRight') next = (index + 1) % buttons.length;
                    else if (event.key === 'ArrowLeft') next = (index - 1 + buttons.length) % buttons.length;
                    else if (event.key === 'Home') next = 0;
                    else if (event.key === 'End') next = buttons.length - 1;
                    else return;
                    event.preventDefault();
                    activate(next);
                    buttons[next].focus();
                });
            });
        });
    }
    initializePriceTabs();
    document.addEventListener('astro:page-load', initializePriceTabs);
</script>
