---
import { formatSeasonDate } from '@/services/season-format';
import SeasonSchedule from './SeasonSchedule.astro';
import type { Fecha } from '@/types/content';

interface Props { fecha: Fecha }
const { fecha } = Astro.props;
---

<div class="space-y-6">
    {(fecha.Inicio || fecha.Fin) && (
        <div class:list={['grid grid-cols-1 gap-6', { 'md:grid-cols-2': fecha.Inicio && fecha.Fin }]}>
            {fecha.Inicio && (
                <article class="border-2 border-secondary rounded-3xl p-6 sm:p-8">
                    <h3 class="text-primary text-outline-2 font-atma font-bold text-3xl mb-4">Inicio de temporada:</h3>
                    <p class="text-white text-2xl sm:text-3xl md:text-2xl xl:text-3xl leading-tight font-bold"><time datetime={fecha.Inicio}>{formatSeasonDate(fecha.Inicio)}</time></p>
                </article>
            )}
            {fecha.Fin && (
                <article class="border-2 border-secondary rounded-3xl p-6 sm:p-8">
                    <h3 class="text-primary text-outline-2 font-atma font-bold text-3xl mb-4">Fin de temporada:</h3>
                    <p class="text-white text-2xl sm:text-3xl md:text-2xl xl:text-3xl leading-tight font-bold"><time datetime={fecha.Fin}>{formatSeasonDate(fecha.Fin)}</time></p>
                </article>
            )}
        </div>
    )}

    {(fecha.IngresoSalida.length > 0 || fecha.HorariosGuardia.length > 0) && (
        <div class:list={['grid grid-cols-1 gap-6', { 'md:grid-cols-2': fecha.IngresoSalida.length > 0 && fecha.HorariosGuardia.length > 0 }]}>
            {fecha.IngresoSalida.length > 0 && <SeasonSchedule title="Horarios de Ingreso y Salida" horarios={fecha.IngresoSalida} />}
            {fecha.HorariosGuardia.length > 0 && <SeasonSchedule title="Horarios de Guardia" horarios={fecha.HorariosGuardia} entryLabel="Entrada" />}
        </div>
    )}

    {fecha.NoLaborables.trim() && (
        <article class="border-2 border-secondary rounded-3xl p-6 sm:p-8">
            <h3 class="text-primary text-outline-2 font-atma font-bold text-2xl md:text-3xl mb-4">Fechas que no se trabajan:</h3>
            <p class="text-white text-lg whitespace-pre-line">{fecha.NoLaborables}</p>
        </article>
    )}
</div>
