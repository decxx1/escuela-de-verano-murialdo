---
import { formatScheduleTime } from '@/services/season-format';
import type { IngresoSalida } from '@/types/content';

interface Props { title: string; horarios: IngresoSalida[]; entryLabel?: string }
const { title, horarios, entryLabel = 'Ingreso' } = Astro.props;
---

<article class="border-2 border-secondary rounded-3xl p-6 sm:p-8">
    <div class="flex items-center gap-3 mb-6">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
        </svg>
        <h3 class="text-primary text-outline-2 font-atma font-bold text-2xl md:text-3xl">{title}</h3>
    </div>
    <div class="grid grid-cols-1 gap-6">
        {horarios.map(horario => (
            <div class="min-w-0">
                <h4 class="text-secondary font-bold text-xl mb-3">{horario.Turno}</h4>
                <dl class="grid grid-cols-1 lg:grid-cols-2 gap-3">
                    <div>
                        <dt class="text-white font-semibold text-base">{entryLabel}:</dt>
                        <dd class="text-white text-base">{formatScheduleTime(horario.Ingreso, horario.IngresoHasta)}</dd>
                    </div>
                    <div>
                        <dt class="text-white font-semibold text-base">Salida:</dt>
                        <dd class="text-white text-base">{formatScheduleTime(horario.Salida, horario.SalidaHasta)}</dd>
                    </div>
                </dl>
            </div>
        ))}
    </div>
</article>
