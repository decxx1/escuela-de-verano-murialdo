---
import type { ArchivoFormulario } from '@/types/content';
interface Props { formulario: ArchivoFormulario }
const { formulario } = Astro.props;
---

<article class="border-2 border-secondary rounded-3xl p-6 sm:p-10 bg-linear-to-br from-secondary/10 to-transparent">
    <div class="flex flex-col sm:flex-row items-start gap-6">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-secondary/15 text-secondary">
            <svg aria-hidden="true" class="h-8 w-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6M8 13h8M8 17h5" />
            </svg>
        </div>
        <div class="min-w-0 flex-1">
            <h3 class="text-primary text-outline-2 font-atma font-bold text-3xl sm:text-4xl mb-3">Formulario de inscripción</h3>
            <p class="text-white/85 text-lg leading-relaxed">Descargá el formulario para completar tu inscripción a la escuela de verano.</p>
            <p class="mt-3 text-white/60 text-sm break-words">PDF · {formulario.name}</p>
            <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
                <a href={formulario.url} download={formulario.name} class="inline-flex items-center justify-center gap-3 bg-secondary hover:bg-secondary/90 text-primary font-bold py-4 px-6 rounded-2xl transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary">
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
                    </svg>
                    Descargar formulario
                </a>
            </div>
        </div>
    </div>
</article>
