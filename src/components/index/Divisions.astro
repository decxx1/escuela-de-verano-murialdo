---
import { divisionesService } from '@/services/cms';
import type { DivisionEdad } from '@/types/content';

let divisiones: DivisionEdad[] = [];
try {
  const response = await divisionesService.getDivisiones();
  divisiones = response.data;
} catch (error) {
  if (import.meta.env.PROD) throw error;
  console.error('Error al obtener divisiones:', error);
}
---

<section class="container mx-auto scroll-mt-28 px-4 py-20 sm:scroll-mt-36 sm:py-24" id="edades" aria-labelledby="edades-titulo">
  <div class="mx-auto max-w-7xl">
    <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
      <h2 id="edades-titulo" class="font-atma text-4xl font-bold leading-tight text-tertiary text-outline-4 sm:text-5xl lg:text-6xl">
        Divisiones por edades
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-white/85 sm:text-xl">
        Grupos para chicos y chicas de 3 a 14 años, organizados en turno mañana y turno tarde.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-12 lg:gap-6">
      {divisiones.map((division, divisionIndex) => (
        <article class:list={[
          'relative overflow-hidden rounded-4xl border-2 border-secondary bg-transparent p-5 shadow-[0_18px_50px_rgba(0,0,0,0.12)] sm:p-8',
          divisionIndex === 0 ? 'lg:col-span-12' : 'lg:col-span-8',
        ]}>
          <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-28 size-72 rounded-full border-[2.5rem] border-white/[0.035]"></div>

          <header class="relative mb-6 flex items-center gap-4 sm:mb-8">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-2xl bg-header font-atma text-2xl font-bold text-white shadow-[0_6px_0_rgba(4,36,110,0.35)] sm:size-14 sm:text-3xl" aria-hidden="true">
              {String(divisionIndex + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-secondary sm:text-sm">Divisiones por turno</p>
              <h3 class="font-atma text-3xl font-bold leading-tight text-white sm:text-4xl">{division.Titulo}</h3>
            </div>
          </header>

          <ul class="relative grid gap-2.5 sm:gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.25rem), 1fr))">
            {division.Columna.map((columna, columnIndex) => (
              <li class:list={[
                'group relative min-h-32 overflow-hidden rounded-2xl border border-white/10 bg-primary/55 p-3 transition-[background-color,border-color,transform] duration-200 hover:-translate-y-1 hover:border-secondary/60 hover:bg-primary/80 sm:min-h-40 sm:p-5',
                division.Columna.length === 3 && 'min-[360px]:max-[479px]:last:col-span-2',
              ]}>
                <span aria-hidden="true" class="pointer-events-none absolute -bottom-8 right-2 font-atma text-[7rem] font-bold leading-none text-white/4.5 sm:text-[9rem]">
                  {columnIndex + 1}
                </span>
                <div class="relative flex h-full flex-col justify-between gap-5">
                  <span class="text-xs font-bold uppercase tracking-[0.16em] text-secondary sm:text-sm">{columna.Division}</span>
                  <span class="max-w-40 text-xl font-bold leading-tight text-white sm:text-2xl">{columna.Edades}</span>
                </div>
              </li>
            ))}
          </ul>
        </article>
      ))}

      <aside class="relative overflow-hidden border-secondary border rounded-4xl bg-transparent p-7 text-white shadow-[0_18px_50px_rgba(0,0,0,0.12)] sm:p-8 lg:col-span-4 lg:flex lg:flex-col lg:justify-between">
        <div aria-hidden="true" class="pointer-events-none absolute -bottom-20 -right-20 size-64 rounded-full border-[2.5rem] border-primary/10"></div>
        <div class="relative mb-8 flex size-14 items-center justify-center rounded-2xl bg-header text-white sm:size-16">
          <svg class="size-8" aria-hidden="true" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M7 22c3.5-5 7-7.5 10.5-7.5 3 0 5.1 1.6 7.5 4.5M7 15c3-4 5.8-6 8.5-6 2.4 0 4.4 1 6.5 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            <circle cx="7" cy="22" r="2" fill="currentColor" /><circle cx="25" cy="19" r="2" fill="currentColor" />
          </svg>
        </div>
        <div class="relative">
          <h3 class="font-atma text-3xl font-bold leading-tight sm:text-4xl">Grupos flexibles</h3>
          <p class="mt-3 max-w-sm text-base font-medium leading-relaxed sm:text-lg">
            Las divisiones de ambos turnos pueden ajustarse según las necesidades de los chicos y sus familias.
          </p>
        </div>
      </aside>
    </div>
  </div>
</section>
